---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { screenshots } from "../data/screenshots";
import SyncExplanation from "./SyncExplanation.astro";
import MetadataExplanation from "./MetadataExplanation.astro";
import {
  projects,
  projectOrder,
  type ProjectSlug,
  type Language,
} from "../data/projects";
interface Props {
  slug: ProjectSlug;
  lang?: Language;
}
const { slug, lang = "en" } = Astro.props;
const project = projects[slug];
const c = project[lang];
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const next =
  projectOrder[(projectOrder.indexOf(slug) + 1) % projectOrder.length];
const explanations = {
  sync: SyncExplanation,
  metadata: MetadataExplanation,
};
---

<Site
  lang={lang}
  title={`${project.name} | Adrian Mokrzycki`}
  description={c.summary}
>
  <a class="back-link text-link" href={`${base}/#work`}>
    <svg
      class="arrow"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M20 12H5m6-6-6 6 6 6" />
    </svg>
    {pl ? "Wybrane projekty" : "Selected work"}
  </a>
  <div class:list={["case-opening", "case-opening-" + slug]}>
    <header class="case-heading">
      <div>
        <h1>{project.name}</h1>
        <p class="metadata">{c.kind}</p>
      </div>
      <p class="case-tagline">{c.tagline}</p>
    </header>
    <figure class="case-figure">
      <ProductImage
        slug={slug}
        alt={c.alt}
        eager
        sizes={
          slug !== "kajtek"
            ? "(max-width: 700px) calc(100vw - 68px), (max-width: 1400px) 85vw, 1224px"
            : undefined
        }
      />
    </figure>
  </div>
  <section class="case-intro editorial-row">
    <h2>{c.intro}</h2>
    <div class="reading-copy">
      <p class="lead">{c.overview}</p>
      <div class="project-links">
        <a class="text-link" href={project.repo}>
          {"backendRepo" in project
            ? pl
              ? "Kod frontendu"
              : "Frontend source"
            : pl
              ? "Kod źródłowy"
              : "View source"}
          <Arrow external />
        </a>
        {"backendRepo" in project && (
          <a class="text-link" href={project.backendRepo}>
            {pl ? "Kod backendu" : "Backend source"}
            <Arrow external />
          </a>
        )}
        {slug === "random-frame" && (
          <a class="text-link" href={`${project.repo}/releases/`}>
            {pl ? "Pobierz aplikację" : "Download the app"}
            <Arrow external />
          </a>
        )}
      </div>
    </div>
  </section>
  <div class="case-body">
    {c.sections.map((section, index) => {
      const Explanation =
        "explanation" in section
          ? explanations[section.explanation]
          : undefined;
      return (
        <section
          class:list={[
            "case-section",
            "editorial-row",
            { "case-explained": Boolean(Explanation) },
          ]}
        >
          <h2>{section.title}</h2>
          <div class="reading-copy">
            <p>{section.text}</p>
          </div>
          {Explanation && <Explanation lang={lang} />}
          <details class="engineering-details">
            <summary>
              <span>
                <span class="detail-topic">{section.detail.topic}</span>
              </span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                aria-hidden="true"
              >
                <path d="M8 2v12M2 8h12" />
              </svg>
            </summary>
            <div class="detail-content">
              <p>{section.detail.mechanism}</p>
              <p>{section.detail.constraint}</p>
            </div>
          </details>
          {screenshots[slug]
            .filter((shot) => shot.section === index)
            .map((shot) => (
              <figure
                class:list={[
                  "section-media",
                  {
                    "media-wide": shot.wide,
                    "media-portrait": shot.source.height > shot.source.width,
                  },
                ]}
              >
                <ProductImage
                  slug={slug}
                  source={shot.source}
                  mobileSource={
                    "mobileSource" in shot ? shot.mobileSource : undefined
                  }
                  original={shot.original}
                  focusY={shot.focusY}
                  sizes={
                    shot.wide
                      ? "(max-width: 700px) calc(100vw - 64px), 1100px"
                      : "(max-width: 700px) calc(100vw - 64px), (max-width: 1400px) 50vw, 700px"
                  }
                  alt={shot.alt[lang]}
                />
                <figcaption>{shot[lang]}</figcaption>
              </figure>
            ))}
        </section>
      );
    })}
  </div>
  <a class="next-project" href={`${base}/work/${next}/`}>
    <span>{pl ? "Następny projekt" : "Next project"}</span>
    <span>
      {projects[next].name}
      <Arrow />
    </span>
  </a>
</Site>
