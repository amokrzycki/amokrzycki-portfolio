---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { screenshots } from "../data/screenshots";
import SyncExplanation from "./SyncExplanation.astro";
import StreamExplanation from "./StreamExplanation.astro";
import { projects, type ProjectSlug, type Language } from "../data/projects";
interface Props {
  slug: ProjectSlug;
  lang?: Language;
}
const { slug, lang = "en" } = Astro.props;
const project = projects[slug];
const c = project[lang];
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const next = slug === "random-frame" ? "kajtek" : "random-frame";
---

<Site
  lang={lang}
  title={`${project.name} — Adrian Mokrzycki`}
  description={c.summary}
>
  <a class="back-link text-link" href={`${base}/#work`}>
    <svg
      class="arrow"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M20 12H5m6-6-6 6 6 6" />
    </svg>
    {pl ? "Wybrane projekty" : "Selected work"}
  </a>
  <div class:list={["case-opening", "case-opening-" + slug]}>
    <header class="case-heading">
      <div>
        <h1>{project.name}</h1>
        <p class="metadata">{c.kind}</p>
      </div>
      <p class="case-tagline">{c.tagline}</p>
    </header>
    <figure class="case-figure">
      <ProductImage slug={slug} alt={c.alt} eager />
    </figure>
  </div>
  <section class="case-intro editorial-row">
    <h2>{c.intro}</h2>
    <div class="reading-copy">
      <p class="lead">{c.overview}</p>
      <a class="text-link" href={project.repo}>
        {pl ? "Kod źródłowy" : "View source"}
        <Arrow external />
      </a>
    </div>
  </section>
  <div class="case-body">
    {c.sections.map((section, index) => (
      <section
        class:list={[
          "case-section",
          "editorial-row",
          { "case-explained": index === 2 },
        ]}
      >
        <h2>{section.title}</h2>
        <div class="reading-copy">
          <p>{section.text}</p>
        </div>
        {index === 2 &&
          (slug === "random-frame" ? (
            <SyncExplanation lang={lang} />
          ) : (
            <StreamExplanation lang={lang} />
          ))}
        <details class="engineering-details">
          <summary>
            <span>
              <span class="detail-category">
                {pl ? "Szczegóły techniczne" : "Engineering details"}
              </span>
              <span class="detail-topic">{section.detail.topic}</span>
            </span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              aria-hidden="true"
            >
              <path d="M8 2v12M2 8h12" />
            </svg>
          </summary>
          <dl class="detail-content">
            <div>
              <dt>{pl ? "Decyzja" : "Decision"}</dt>
              <dd>{section.detail.decision}</dd>
            </div>
            <div>
              <dt>{pl ? "Mechanizm" : "Mechanism"}</dt>
              <dd>{section.detail.mechanism}</dd>
            </div>
            <div>
              <dt>{pl ? "Ograniczenie" : "Constraint"}</dt>
              <dd>{section.detail.constraint}</dd>
            </div>
          </dl>
        </details>
      </section>
    ))}
  </div>
  <section class="project-gallery" aria-labelledby="gallery-heading">
    <h2 id="gallery-heading">{pl ? "W aplikacji" : "Inside the app"}</h2>
    {screenshots[slug].map((shot) => (
      <figure>
        <ProductImage
          slug={slug}
          source={shot.source}
          alt={`${project.name}: ${shot[lang]}`}
        />
        <figcaption>{shot[lang]}</figcaption>
      </figure>
    ))}
  </section>
  <a class="next-project" href={`${base}/work/${next}/`}>
    <span>{pl ? "Drugi projekt" : "The other project"}</span>
    <span>
      {projects[next].name}
      <Arrow />
    </span>
  </a>
</Site>
