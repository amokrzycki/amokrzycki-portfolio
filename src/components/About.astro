---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import type { Language } from "../data/projects";

interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const pl = lang === "pl";
const home = pl ? "/pl/" : "/";
const c = pl
  ? {
      title: "O mnie",
      intro: [
        "Jestem programistą full-stack i pracuję zawodowo od 2021 roku. Zaczynałem od frontendu, który nadal jest główną częścią mojej pracy. Gdy problem ma źródło w innej części aplikacji, zajmuję się też backendem, danymi czy infrastrukturą.",
      ],
      experience: "Doświadczenie",
      jobs: [
        {
          company: "Railwaymen",
          role: "Frontend Developer",
          date: "od mar 2026",
          scope:
            "Tworzę funkcje w aplikacji z React 19 i TypeScriptem oraz API w Ruby on Rails. Zajmuję się schematem bazy danych, autoryzacją, projektowaniem API i interfejsem. Pracuję m.in. nad dashboardami, wizualizacją danych, zapisywaniem i udostępnianiem widoków, eksportami oraz integracjami. Refaktoryzuję też wspólny kod, piszę testy i rozwijam narzędzia do budowania i wdrażania aplikacji.",
        },
        {
          company: "GumGum",
          role: "Frontend Developer",
          date: "sty 2023 do mar 2026",
          scope:
            "Pracowałem nad produktami AdTech używanymi w regionie EMEA, w tym interfejsami do konfiguracji reklam i narzędziami wewnętrznymi. Odpowiadałem za starszy system szablonów i tworzyłem narzędzia do sprawdzania oraz debugowania integracji reklamowych. Pracowałem też z wewnętrznymi usługami NestJS, poprawiałem wydajność i monitoring aplikacji. Okresowo kierowałem pracą zespołu, gdy brakowało osoby odpowiedzialnej za nadzór techniczny.",
        },
        {
          company: "GumGum",
          role: "Junior Frontend Developer",
          date: "cze 2021 do sty 2023",
          scope:
            "Zaczynałem od dostosowywania i utrzymywania wewnętrznych platform reklamowych dla różnych rynków EMEA, pracując z JavaScriptem, HTML, CSS i systemami szablonów. Z czasem zajmowałem się również problemami integracyjnymi, wydajnością frontendu oraz dokumentacją techniczną wykorzystywaną przez zespół.",
        },
      ],
      education: "Wykształcenie",
      degree: "Mgr inż. informatyki · Cyberbezpieczeństwo · 2026",
      range: "Zakres pracy",
      tools: [
        {
          name: "React i TypeScript",
          text: "Technologie, z których korzystam najczęściej, zarówno zawodowo, jak i we własnym oprogramowaniu.",
        },
        {
          name: "Rails",
          text: "Korzystam z Rails w Railwaymen. Pracuję nad modelami danych, logiką API, autoryzacją i usługami aplikacji.",
        },
        {
          name: "Node.js i Rust",
          text: "Wykorzystuję je przede wszystkim we własnych projektach, gdy problem wykracza poza przeglądarkę albo lepiej pasuje do innego środowiska.",
        },
        {
          name: "API, dane i infrastruktura",
          text: "Pracuję też z API, danymi i infrastrukturą, gdy tam znajduje się przyczyna problemu widocznego w interfejsie.",
        },
      ],
      personal: "Własne projekty",
      personalText:
        "Najczęściej tworzę aplikacje, których później sam używam. W codziennym użyciu wychodzą na jaw błędne założenia, niewygodna obsługa i skutki skrótów w kodzie. Wracam do tych problemów i rozwijam projekty także po wydaniu pierwszej działającej wersji.",
      selected: "Wybrane projekty",
      contact: "Kontakt",
    }
  : {
      title: "About me",
      intro: [
        "I’m a full-stack engineer and have worked in software since 2021. I started on the frontend, which is still my main focus. When a problem starts elsewhere in the application, I work on the backend, data or infrastructure too.",
      ],
      experience: "Experience",
      jobs: [
        {
          company: "Railwaymen",
          role: "Frontend Developer",
          date: "Mar 2026 to present",
          scope:
            "I build features across a React 19 and TypeScript SPA and a Ruby on Rails API, covering database schemas, authorization, API design and UI. My work includes dashboards, data visualizations, saved and shared views, exports and third-party integrations. I also refactor shared code, write automated tests and work on build and deployment tools.",
        },
        {
          company: "GumGum",
          role: "Frontend Developer",
          date: "Jan 2023 to Mar 2026",
          scope:
            "I worked on AdTech products used across EMEA, from customer-facing configuration interfaces to internal tooling. I took responsibility for a legacy templating system, built tools for inspecting and debugging advertising integrations, worked with internal NestJS services, and improved application performance and monitoring. I also temporarily led development work during gaps in technical management.",
        },
        {
          company: "GumGum",
          role: "Junior Frontend Developer",
          date: "Jun 2021 to Jan 2023",
          scope:
            "I started by adapting and maintaining internal advertising platforms for different EMEA markets, working with JavaScript, HTML, CSS and templating systems. The role grew into investigating integration issues, improving frontend performance and maintaining technical documentation used by the wider team.",
        },
      ],
      education: "Education",
      degree: "M.Sc. Eng. in Information Technology · Cybersecurity · 2026",
      range: "What I work with",
      tools: [
        {
          name: "React & TypeScript",
          text: "The tools I use most often, both professionally and in my own software.",
        },
        {
          name: "Rails",
          text: "Part of my current full-stack work at Railwaymen, from data models and API logic to authorization and application services.",
        },
        {
          name: "Node.js & Rust",
          text: "Used primarily in my own projects when the problem extends beyond the browser or benefits from a different runtime.",
        },
        {
          name: "APIs, data & infrastructure",
          text: "I also work on APIs, data and infrastructure when they are the source of a problem in the interface.",
        },
      ],
      personal: "Personal projects",
      personalText:
        "I usually build software that I keep using myself. Daily use exposes flawed assumptions, awkward interactions and the consequences of shortcuts in the code. I return to those problems and keep developing the projects after the first working release.",
      selected: "Selected work",
      contact: "Contact",
    };
---

<Site
  lang={lang}
  title={`${c.title} | Adrian Mokrzycki`}
  description={c.intro[0]}
>
  <div class="profile">
    <section
      class="profile-opening editorial-row"
      aria-labelledby="about-title"
    >
      <h1 id="about-title">{c.title}</h1>
      <div class="reading-copy">
        {c.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
    <section class="profile-section editorial-row" aria-labelledby="experience">
      <h2 id="experience">{c.experience}</h2>
      <div class="reading-copy experience-entries">
        {c.jobs.map((job) => (
          <article class="experience-entry">
            <h3>{job.company}</h3>
            <p class="entry-role">{job.role}</p>
            <p class="entry-date">{job.date}</p>
            <p class="entry-scope">{job.scope}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="profile-section editorial-row" aria-labelledby="education">
      <h2 id="education">{c.education}</h2>
      <div class="reading-copy education-entry">
        <h3>Wyższa Szkoła Informatyki i Zarządzania w Rzeszowie</h3>
        <p class="entry-degree">{c.degree}</p>
      </div>
    </section>
    <section
      class="profile-section editorial-row"
      aria-labelledby="working-range"
    >
      <h2 id="working-range">{c.range}</h2>
      <dl class="reading-copy working-range">
        {c.tools.map((tool) => (
          <div>
            <dt>{tool.name}</dt>
            <dd>{tool.text}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section class="profile-section editorial-row" aria-labelledby="personal">
      <h2 id="personal">{c.personal}</h2>
      <div class="reading-copy">
        <p>{c.personalText}</p>
      </div>
    </section>
    <div class="profile-closing editorial-row">
      <div class="profile-links">
        <a class="text-link" href={`${home}#work`}>
          {c.selected}
          <Arrow />
        </a>
        <a class="text-link" href={`${home}#contact`}>
          {c.contact}
          <Arrow />
        </a>
      </div>
    </div>
  </div>
</Site>

<style>
  .profile-opening {
    padding-block: 45px 60px;
  }
  .profile-opening h1 {
    font-size: clamp(3rem, 6vw, 5rem);
  }
  .profile-section {
    padding-block: 50px;
    border-top: 1px solid var(--rule);
  }
  .profile h3 {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.018em;
  }
  .experience-entry + .experience-entry {
    margin-top: 40px;
  }
  .profile .entry-role,
  .profile .entry-degree {
    margin-top: 8px;
    color: var(--ink);
    font-weight: 500;
  }
  .profile .entry-date {
    margin-top: 4px;
    font-size: 13px;
  }
  .profile .entry-scope {
    margin-top: 18px;
  }
  .working-range {
    font-size: 15px;
  }
  .working-range > div + div {
    margin-top: 24px;
  }
  .working-range dt {
    font-weight: 600;
  }
  .working-range dd {
    margin-top: 8px;
    color: var(--muted);
  }
  .profile-closing {
    padding-bottom: 60px;
  }
  .profile-links {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
  }
  @media (max-width: 700px) {
    .profile-opening {
      padding-block: 48px 38px;
    }
    .profile-opening h1 {
      font-size: clamp(2.8rem, 10vw, 4.5rem);
    }
    .profile-section {
      padding-block: 38px;
    }
    .profile-closing {
      padding-bottom: 38px;
    }
    .profile-links {
      grid-column: 1;
    }
  }
</style>
