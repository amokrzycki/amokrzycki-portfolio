---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { projects, type Language, type ProjectSlug } from "../data/projects";
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const c = pl
  ? {
      hero: ["Oprogramowanie.", "Z namysłem."],
      intro:
        "Jestem Adrian, inżynier full-stack. Od 2021 roku buduję oprogramowanie, skupiając się na interfejsach.",
      selected: "Wybrane projekty",
      selectedNote: "Dwa projekty osobiste",
      explore: "Poznaj projekt",
      approach: ["Zaczynam od interfejsu.", "Podążam za problemem."],
      approachText:
        "W Kajtku informacje o utworze i sam dźwięk przychodzą z różnych źródeł. W Random Frame dwa urządzenia mogą zmieniać tę samą historię. W obu przypadkach problem zaczyna się w interfejsie i prowadzi do sposobu przetwarzania danych.",
      areas: [
        ["Interfejsy", "Produkt, interakcje, dostępność i wydajność."],
        ["Aplikacje", "Architektura, stan, synchronizacja i desktop."],
        ["Systemy", "API, bazy danych, bezpieczeństwo i usługi."],
        ["Dostarczenie", "Linux, CI/CD, wdrożenia i infrastruktura."],
      ],
      about: "O mnie.",
      aboutText:
        "Zawodowo pracuję nad oprogramowaniem od 2021 roku. Jestem inżynierem full-stack, ale najwięcej czasu spędzam przy frontendzie. Zwykle zaczynam od tego, co użytkownik próbuje zrobić i gdzie aplikacja mu to utrudnia.",
      aboutMore:
        "Dużo uwagi poświęcam zachowaniu interfejsu: temu, co pokazuje po kliknięciu, na co trzeba czekać i jak wrócić po błędzie. To często prowadzi do stanu aplikacji, API albo przechowywania danych. Zajmuję się tym po drodze, bo te decyzje wpływają na to, jak korzysta się z produktu.",
      aboutTools:
        "Najczęściej pracuję z Reactem i TypeScriptem. Gdy problem tego wymaga, sięgam też do usług backendowych w Rails lub Node, Rusta, bezpieczeństwa, wdrożeń i infrastruktury. Własne projekty dają mi okazję przejść przez cały ten proces i wracać do decyzji po dłuższym używaniu aplikacji.",
      education:
        "Magister informatyki ze specjalizacją w cyberbezpieczeństwie.",
      contact: "Masz coś na myśli?",
      contactText: "Napisz do mnie lub zobacz moje projekty na GitHubie.",
      email: "Porozmawiajmy",
    }
  : {
      hero: ["Software,", "considered."],
      intro:
        "I’m Adrian, a full-stack engineer. I’ve been building software since 2021, with a focus on interfaces.",
      selected: "Selected work",
      selectedNote: "Two personal projects",
      explore: "Explore the project",
      approach: [
        "The interface is where I start.",
        "The problem decides where I go.",
      ],
      approachText:
        "In Kajtek, the song information and the audio come from different sources. In Random Frame, two devices can change the same history. Both start as interface problems and lead into how the application handles its data.",
      areas: [
        [
          "Interfaces",
          "Product UI, interaction, accessibility and performance.",
        ],
        ["Applications", "Architecture, state, synchronization and desktop."],
        ["Systems", "APIs, databases, security and backend services."],
        ["Delivery", "Linux, CI/CD, deployment and infrastructure."],
      ],
      about: "About me.",
      aboutText:
        "I’ve worked in software professionally since 2021. I’m a full-stack engineer who spends most of my time on the frontend. I usually start with what someone is trying to do and where the application gets in their way.",
      aboutMore:
        "I pay attention to what happens after a click, what needs to wait, and how someone gets back from an error. That often takes me into application state, an API, or how data is stored. I work through those parts too, because they affect how the product feels to use.",
      aboutTools:
        "Most of my work is in React and TypeScript. I also work with Rails and Node services, Rust, security, deployment and infrastructure when the problem calls for it. My own projects let me follow that process through and revisit decisions after living with the software for a while.",
      education:
        "M.Sc. in Information Technology, specializing in cybersecurity.",
      contact: "Have something in mind?",
      contactText: "You can reach me by email or find my projects on GitHub.",
      email: "Get in touch",
    };
const selected: ProjectSlug[] = ["random-frame", "kajtek"];
---

<Site
  lang={lang}
  title="Adrian Mokrzycki — Full-stack engineer"
  description={
    pl
      ? "Adrian Mokrzycki, inżynier full-stack. Pracuję nad oprogramowaniem od 2021 roku. Projekty osobiste: Random Frame i Kajtek."
      : "Adrian Mokrzycki, full-stack engineer working in software since 2021. Personal projects: Random Frame and Kajtek."
  }
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">
      {c.hero[0]}
      <br />
      {c.hero[1]}
    </h1>
    <div class="hero-note">
      <p>{c.intro}</p>
      <a class="text-link" href="#work">
        {c.selected}
        <Arrow />
      </a>
    </div>
  </section>
  <section
    class="about editorial-row"
    id="about"
    aria-labelledby="about-heading"
  >
    <h2 id="about-heading">{c.about}</h2>
    <div class="reading-copy">
      <p class="lead">{c.aboutText}</p>
      <p>{c.aboutMore}</p>
      <p>{c.aboutTools}</p>
      <p class="education">{c.education}</p>
    </div>
  </section>
  <section class="selected-work" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">{c.selected}</h2>
      <p>{c.selectedNote}</p>
    </div>
    {selected.map((slug, index) => {
      const project = projects[slug];
      const content = project[lang];
      return (
        <article class:list={["project-spread", "spread-" + slug]}>
          <div class="project-identity">
            <h3>
              <a href={`${base}/work/${slug}/`}>{project.name}</a>
            </h3>
            <p class="metadata">{content.kind}</p>
            <p class="project-tagline">{content.tagline}</p>
          </div>
          <ProductImage slug={slug} alt={content.alt} eager={index === 0} />
          <div class="project-caption">
            <p>{content.summary}</p>
            <a class="text-link" href={`${base}/work/${slug}/`}>
              {c.explore}
              <Arrow />
            </a>
          </div>
        </article>
      );
    })}
  </section>
  <section class="approach" aria-labelledby="approach-heading">
    <h2 id="approach-heading">
      <span>{c.approach[0]}</span>
      <span>{c.approach[1]}</span>
    </h2>
    <p class="approach-note">{c.approachText}</p>
    <dl class="capabilities">
      {c.areas.map(([name, description]) => (
        <div>
          <dt>{name}</dt>
          <dd>{description}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section
    class="contact editorial-row"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">{c.contact}</h2>
    <div>
      <p>{c.contactText}</p>
      <a class="contact-link" href="mailto:contact@amokrzycki.ovh">
        {c.email}
        <Arrow external />
      </a>
      <p class="email-address">contact@amokrzycki.ovh</p>
    </div>
  </section>
</Site>
