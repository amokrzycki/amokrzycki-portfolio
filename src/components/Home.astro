---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { projects, projectOrder, type Language } from "../data/projects";
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const c = pl
  ? {
      intro:
        "Jestem programistą full-stack. Pracuję zawodowo od 2021 roku, głównie przy frontendzie.",
      about: "O mnie",
      aboutText:
        "Zwykle zaczynam od interfejsu i sprawdzam, skąd bierze się problem. Czasem trzeba poprawić stan aplikacji lub sposób komunikacji z API, a czasem model danych, backend czy wdrożenie. Zajmuję się też tymi częściami aplikacji.",
      aboutTools:
        "Pracuję w Railwaymen przy frontendzie i aplikacjach opartych na Rails. Na co dzień korzystam z Reacta i TypeScriptu. We własnych projektach używam też Node.js i Rusta oraz zajmuję się infrastrukturą, gdy wymaga tego aplikacja. Ukończyłem studia magisterskie z informatyki ze specjalizacją w cyberbezpieczeństwie.",
      selected: "Wybrane projekty",
      selectedNote: "Własne projekty",
      explore: "O projekcie",
      approach: "Jak pracuję",
      approachText:
        "We własnych projektach tworzę interfejs i usługi, z których korzysta aplikacja. Później sam jej używam. Z czasem zauważam, co jest niewygodne, i wracam do wcześniejszych decyzji.",
      approachMore:
        "W Random Frame musiałem zadbać o to, żeby historia była szyfrowana, a zmiany z kilku urządzeń dało się połączyć. W Kajtku sprawdzam, czy tytuł z API dotyczy utworu, który właśnie słychać. To, co ma działać w interfejsie, często wymaga więc pracy także po stronie danych i backendu.",
      contact: "Porozmawiajmy",
      contactText:
        "Napisz, jeśli chcesz porozmawiać o projekcie lub wspólnej pracy.",
    }
  : {
      intro:
        "I’m a full-stack engineer. I’ve worked in software since 2021, mostly on the frontend.",
      about: "About me",
      aboutText:
        "I usually start with the interface and trace the problem to its source. That can mean changing application state or an API contract, fixing the data model, or working on the backend or deployment.",
      aboutTools:
        "I work at Railwaymen on frontend and Rails applications, using React and TypeScript day to day. In my own projects, I also use Node.js and Rust and handle infrastructure when the application needs it. I hold an M.Sc. Eng. in Information Technology, specializing in Cybersecurity.",
      selected: "Selected work",
      selectedNote: "Personal projects",
      explore: "Explore the project",
      approach: "How I work",
      approachText:
        "In my own projects, I build the interface and the services behind it. Then I use the software myself. Over time, I notice what gets in the way and revisit earlier decisions.",
      approachMore:
        "In Random Frame, I had to encrypt browsing history and merge changes from several devices. In Kajtek, I check whether the API’s track title matches the song playing in the stream. Getting the interface right often means working on the data and backend too.",
      contact: "Let’s talk",
      contactText: "Email me about a project or working together.",
    };
---

<Site
  lang={lang}
  title={
    pl
      ? "Adrian Mokrzycki | Programista full-stack"
      : "Adrian Mokrzycki | Full-stack engineer"
  }
  description={
    pl
      ? "Adrian Mokrzycki, programista full-stack skupiony na frontendzie. Projekty: Random Frame, Kajtek i Zielony Koszyk."
      : "Adrian Mokrzycki, a full-stack engineer with a focus on interfaces. Projects: Random Frame, Kajtek and Zielony Koszyk."
  }
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">
      {pl ? "Tworzę" : "I build"}
      <br />
      {pl ? "aplikacje." : "software."}
    </h1>
    <div class="hero-note">
      <p>{c.intro}</p>
      <a class="text-link" href="#work">
        {c.selected}
        <Arrow />
      </a>
    </div>
  </section>
  <section
    class="about editorial-row"
    id="about"
    aria-labelledby="about-heading"
  >
    <h2 id="about-heading">{c.about}</h2>
    <div class="reading-copy">
      <p>{c.aboutText}</p>
      <p>{c.aboutTools}</p>
      <a class="text-link" href={`${base}/about/`}>
        {pl ? "Więcej o mnie" : "More about me"}
        <Arrow />
      </a>
    </div>
  </section>
  <section class="selected-work" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">{c.selected}</h2>
      <p>{c.selectedNote}</p>
    </div>
    {projectOrder.map((slug, index) => {
      const project = projects[slug];
      const content = project[lang];
      return (
        <>
          <article class:list={["project-spread", "spread-" + slug]}>
            <div class="project-identity">
              <h3>
                <a href={`${base}/work/${slug}/`}>{project.name}</a>
              </h3>
              <p class="metadata">{content.kind}</p>
              <p class="project-tagline">{content.tagline}</p>
            </div>
            <ProductImage slug={slug} alt={content.alt} eager={index === 0} />
            <div class="project-caption">
              <p>{content.summary}</p>
              <a class="text-link" href={`${base}/work/${slug}/`}>
                {c.explore}
                <Arrow />
              </a>
            </div>
          </article>
          {index === 0 && (
            <section
              class="approach editorial-row"
              aria-labelledby="approach-heading"
            >
              <h2 id="approach-heading">{c.approach}</h2>
              <div class="reading-copy">
                <p>{c.approachText}</p>
                <p>{c.approachMore}</p>
              </div>
            </section>
          )}
        </>
      );
    })}
  </section>
  <section
    class="contact editorial-row"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">{c.contact}</h2>
    <div>
      <p>{c.contactText}</p>
      <a class="contact-link" href="mailto:contact@amokrzycki.ovh">
        contact@amokrzycki.ovh
        <Arrow external />
      </a>
    </div>
  </section>
</Site>
