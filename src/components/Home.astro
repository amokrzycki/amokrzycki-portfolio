---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { projects, type Language, type ProjectSlug } from "../data/projects";
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const c = pl
  ? {
      hero: ["Oprogramowanie.", "Z namysłem."],
      intro:
        "Jestem Adrian, inżynier full-stack. Od 2021 roku buduję oprogramowanie, skupiając się na interfejsach.",
      selected: "Wybrane projekty",
      selectedNote: "Dwa projekty osobiste",
      explore: "Poznaj projekt",
      approach: ["Zaczynam od interfejsu.", "Podążam za problemem."],
      approachText:
        "Przy odtwarzaczu radia oznacza to obsługę przerw w strumieniu. Przy galerii desktopowej — zachowanie historii, gdy dwa urządzenia zapisują zmiany jednocześnie.",
      areas: [
        ["Interfejsy", "Produkt, interakcje, dostępność i wydajność."],
        ["Aplikacje", "Architektura, stan, synchronizacja i desktop."],
        ["Systemy", "API, bazy danych, bezpieczeństwo i usługi."],
        ["Dostarczenie", "Linux, CI/CD, wdrożenia i infrastruktura."],
      ],
      about: "O mnie.",
      aboutText:
        "Pracuję nad interfejsami i systemami, które je obsługują. Gdy problem leży w stanie aplikacji, API lub wdrożeniu, zajmuję się również nim.",
      aboutMore:
        "Random Frame i Kajtek to moje projekty osobiste. Projektuję ich interfejsy, piszę kod i utrzymuję wydania.",
      education:
        "Magister informatyki ze specjalizacją w cyberbezpieczeństwie.",
      contact: "Masz coś na myśli?",
      contactText: "Napisz do mnie lub zobacz moje projekty na GitHubie.",
      email: "Porozmawiajmy",
    }
  : {
      hero: ["Software,", "considered."],
      intro:
        "I’m Adrian, a full-stack engineer. I’ve been building software since 2021, with a focus on interfaces.",
      selected: "Selected work",
      selectedNote: "Two personal projects",
      explore: "Explore the project",
      approach: [
        "The interface is where I start.",
        "The problem decides where I go.",
      ],
      approachText:
        "For a radio player, that means handling interrupted streams. For a desktop gallery, it means preserving history when two devices save changes at once.",
      areas: [
        [
          "Interfaces",
          "Product UI, interaction, accessibility and performance.",
        ],
        ["Applications", "Architecture, state, synchronization and desktop."],
        ["Systems", "APIs, databases, security and backend services."],
        ["Delivery", "Linux, CI/CD, deployment and infrastructure."],
      ],
      about: "About me.",
      aboutText:
        "I work on interfaces and the systems behind them. When a problem sits in application state, an API, or deployment, I work on that too.",
      aboutMore:
        "Random Frame and Kajtek are my personal projects. I design their interfaces, write the software, and maintain their releases.",
      education:
        "M.Sc. in Information Technology, specializing in cybersecurity.",
      contact: "Have something in mind?",
      contactText: "You can reach me by email or find my projects on GitHub.",
      email: "Get in touch",
    };
const selected: ProjectSlug[] = ["random-frame", "kajtek"];
---

<Site
  lang={lang}
  title="Adrian Mokrzycki — Full-stack engineer"
  description={
    pl
      ? "Adrian Mokrzycki, inżynier full-stack. Pracuję nad oprogramowaniem od 2021 roku. Projekty osobiste: Random Frame i Kajtek."
      : "Adrian Mokrzycki, full-stack engineer working in software since 2021. Personal projects: Random Frame and Kajtek."
  }
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">
      {c.hero[0]}
      <br />
      {c.hero[1]}
    </h1>
    <div class="hero-note">
      <p>{c.intro}</p>
      <a class="text-link" href="#work">
        {c.selected}
        <Arrow />
      </a>
    </div>
  </section>
  <section
    class="about editorial-row"
    id="about"
    aria-labelledby="about-heading"
  >
    <h2 id="about-heading">{c.about}</h2>
    <div class="reading-copy">
      <p class="lead">{c.aboutText}</p>
      <p>{c.aboutMore}</p>
      <p class="education">{c.education}</p>
    </div>
  </section>
  <section class="selected-work" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">{c.selected}</h2>
      <p>{c.selectedNote}</p>
    </div>
    {selected.map((slug, index) => {
      const project = projects[slug];
      const content = project[lang];
      return (
        <article class:list={["project-spread", "spread-" + slug]}>
          <div class="project-identity">
            <h3>
              <a href={`${base}/work/${slug}/`}>{project.name}</a>
            </h3>
            <p class="metadata">{content.kind}</p>
            <p class="project-tagline">{content.tagline}</p>
          </div>
          <ProductImage slug={slug} alt={content.alt} eager={index === 0} />
          <div class="project-caption">
            <p>{content.summary}</p>
            <a class="text-link" href={`${base}/work/${slug}/`}>
              {c.explore}
              <Arrow />
            </a>
          </div>
        </article>
      );
    })}
  </section>
  <section class="approach" aria-labelledby="approach-heading">
    <h2 id="approach-heading">
      <span>{c.approach[0]}</span>
      <span>{c.approach[1]}</span>
    </h2>
    <p class="approach-note">{c.approachText}</p>
    <dl class="capabilities">
      {c.areas.map(([name, description]) => (
        <div>
          <dt>{name}</dt>
          <dd>{description}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section
    class="contact editorial-row"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">{c.contact}</h2>
    <div>
      <p>{c.contactText}</p>
      <a class="contact-link" href="mailto:contact@amokrzycki.ovh">
        {c.email}
        <Arrow external />
      </a>
      <p class="email-address">contact@amokrzycki.ovh</p>
    </div>
  </section>
</Site>
