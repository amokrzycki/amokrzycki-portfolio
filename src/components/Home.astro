---
import Site from "../layouts/Site.astro";
import Arrow from "./Arrow.astro";
import ProductImage from "./ProductImage.astro";
import { projects, type Language, type ProjectSlug } from "../data/projects";
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const pl = lang === "pl";
const base = pl ? "/pl" : "";
const c = pl
  ? {
      intro:
        "Jestem inżynierem full-stack. Od 2021 roku pracuję nad oprogramowaniem, najwięcej przy frontendzie.",
      about: "O mnie",
      aboutText:
        "Zwykle zaczynam od tego, co ktoś próbuje zrobić i gdzie aplikacja mu to utrudnia. Interesuje mnie, co dzieje się po kliknięciu, na co trzeba czekać i jak wrócić po błędzie.",
      aboutTools:
        "Na co dzień pracuję głównie z Reactem i TypeScriptem. Sięgam też do Rails, Node i Rusta, kiedy trzeba poprawić API, przechowywanie danych albo sposób wdrażania aplikacji.",
      education: "Magister informatyki, specjalizacja: cyberbezpieczeństwo.",
      selected: "Wybrane projekty",
      selectedNote: "Projekty osobiste",
      explore: "Poznaj projekt",
      approach: "Jak pracuję",
      approachText:
        "Własne projekty pozwalają mi przejść od interfejsu do usług, które go obsługują. Wracam do decyzji po dłuższym używaniu aplikacji, kiedy lepiej widać, co przeszkadza.",
      approachMore:
        "W Random Frame zapis historii prowadzi do szyfrowania i scalania zmian. W Kajtku tytuł na kasecie wymaga sprawdzenia, czy API i strumień audio opisują ten sam utwór. Takie zależności decydują o tym, jak daleko sięgam w danym projekcie.",
      contact: "Porozmawiajmy",
      contactText:
        "Napisz, jeśli chcesz porozmawiać o projekcie lub wspólnej pracy.",
    }
  : {
      intro:
        "I’m a full-stack engineer. I’ve worked in software since 2021, mostly on the frontend.",
      about: "About me",
      aboutText:
        "I usually start with what someone is trying to do and where the application gets in their way. I pay attention to what happens after a click, what needs to wait, and how to get back from an error.",
      aboutTools:
        "Most of my day-to-day work is in React and TypeScript. I also work with Rails, Node and Rust when that means improving an API, how data is stored, or how an application is deployed.",
      education:
        "M.Sc. in Information Technology, specializing in cybersecurity.",
      selected: "Selected work",
      selectedNote: "Personal projects",
      explore: "Explore the project",
      approach: "How I work",
      approachText:
        "My own projects let me work through the interface and the services behind it. I revisit decisions after living with the software for a while, when the awkward parts become easier to see.",
      approachMore:
        "In Random Frame, saving history leads into encryption and merging changes. In Kajtek, the title on the cassette means checking whether an API and the audio stream describe the same song. Those connections determine how much of the system I work on.",
      contact: "Let’s talk",
      contactText: "Email me about a project or working together.",
    };
const selected: ProjectSlug[] = ["random-frame", "kajtek"];
---

<Site
  lang={lang}
  title={
    pl
      ? "Adrian Mokrzycki — Inżynier full-stack"
      : "Adrian Mokrzycki — Full-stack engineer"
  }
  description={
    pl
      ? "Adrian Mokrzycki, inżynier full-stack ze szczególnym zainteresowaniem interfejsami. Projekty osobiste: Random Frame i Kajtek."
      : "Adrian Mokrzycki, a full-stack engineer with a focus on interfaces. Personal projects: Random Frame and Kajtek."
  }
>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">
      {pl ? "Kod" : "Software,"}
      <br />
      {pl ? "z namysłem." : "considered."}
    </h1>
    <div class="hero-note">
      <p>{c.intro}</p>
      <a class="text-link" href="#work">
        {c.selected}
        <Arrow />
      </a>
    </div>
  </section>
  <section
    class="about editorial-row"
    id="about"
    aria-labelledby="about-heading"
  >
    <h2 id="about-heading">{c.about}</h2>
    <div class="reading-copy">
      <p>{c.aboutText}</p>
      <p>{c.aboutTools}</p>
      <p class="education">{c.education}</p>
    </div>
  </section>
  <section class="selected-work" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">{c.selected}</h2>
      <p>{c.selectedNote}</p>
    </div>
    {selected.map((slug, index) => {
      const project = projects[slug];
      const content = project[lang];
      return (
        <>
          <article class:list={["project-spread", "spread-" + slug]}>
            <div class="project-identity">
              <h3>
                <a href={`${base}/work/${slug}/`}>{project.name}</a>
              </h3>
              <p class="metadata">{content.kind}</p>
              <p class="project-tagline">{content.tagline}</p>
            </div>
            <ProductImage slug={slug} alt={content.alt} eager={index === 0} />
            <div class="project-caption">
              <p>{content.summary}</p>
              <a class="text-link" href={`${base}/work/${slug}/`}>
                {c.explore}
                <Arrow />
              </a>
            </div>
          </article>
          {index === 0 && (
            <section
              class="approach editorial-row"
              aria-labelledby="approach-heading"
            >
              <h2 id="approach-heading">{c.approach}</h2>
              <div class="reading-copy">
                <p>{c.approachText}</p>
                <p>{c.approachMore}</p>
              </div>
            </section>
          )}
        </>
      );
    })}
  </section>
  <section
    class="contact editorial-row"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">{c.contact}</h2>
    <div>
      <p>{c.contactText}</p>
      <a class="contact-link" href="mailto:contact@amokrzycki.ovh">
        contact@amokrzycki.ovh
        <Arrow external />
      </a>
    </div>
  </section>
</Site>
