---
import { Image } from "astro:assets";
import randomFrame from "../assets/random-frame.webp";
import kajtek from "../assets/kajtek.webp";
import type { ImageMetadata } from "astro";
import type { ProjectSlug } from "../data/projects";
interface Props {
  slug: ProjectSlug;
  alt: string;
  source?: ImageMetadata;
  eager?: boolean;
}
const {
  slug,
  alt,
  source = slug === "random-frame" ? randomFrame : kajtek,
  eager = false,
} = Astro.props;
---

<div class:list={["product-plate", slug]}>
  <Image
    src={source}
    alt={alt}
    widths={[...new Set([480, 828, 1100, source.width])].filter(
      (width) => width <= source.width,
    )}
    style={`--capture-width: ${source.width}px`}
    sizes="(max-width: 700px) 90vw, (max-width: 1400px) 85vw, 1280px"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>
