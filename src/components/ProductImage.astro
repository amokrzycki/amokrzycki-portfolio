---
import { Image, getImage } from "astro:assets";
import randomFrame from "../assets/random-frame.png";
import kajtek from "../assets/kajtek.png";
import zielonyKoszyk from "../assets/zielony-koszyk.png";
import type { ImageMetadata } from "astro";
import type { ProjectSlug } from "../data/projects";
interface Props {
  slug: ProjectSlug;
  alt: string;
  source?: ImageMetadata;
  eager?: boolean;
  sizes?: string;
  original?: string;
  mobileSource?: ImageMetadata;
  focusY?: number;
}
const projectImages = {
  "random-frame": randomFrame,
  kajtek,
  "zielony-koszyk": zielonyKoszyk,
} satisfies Record<ProjectSlug, ImageMetadata>;
const {
  slug,
  alt,
  source = projectImages[slug],
  eager = false,
  original = `/images/${slug}.png`,
  mobileSource,
  focusY = 0.5,
  sizes = slug !== "kajtek"
    ? "(max-width: 700px) calc(100vw - 64px), (max-width: 1400px) 75vw, 1000px"
    : "(max-width: 700px) calc(100vw - 64px), (max-width: 1400px) 50vw, 880px",
} = Astro.props;
const widths = [
  ...new Set([480, 720, 960, 1280, 1600, 2000, source.width]),
].filter((width) => width <= source.width);
const pl = Astro.url.pathname.startsWith("/pl/");
const mobileImages = mobileSource
  ? await Promise.all(
      [480, 720, mobileSource.width].map((width) =>
        getImage({ src: mobileSource, width, format: "png" }),
      ),
    )
  : [];
---

<div class:list={["product-plate", slug]}>
  <a
    class="capture-link"
    href={original}
    data-image-viewer
    data-focus-y={focusY}
    aria-haspopup="dialog"
    aria-label={`${pl ? "Powiększ" : "Enlarge"}: ${alt}`}
  >
    <picture>
      {mobileSource && (
        <source
          media="(max-width: 700px)"
          sizes="calc(100vw - 64px)"
          srcset={mobileImages
            .map(
              (img, index) =>
                `${img.src} ${[480, 720, mobileSource.width][index]}w`,
            )
            .join(", ")}
        />
      )}
      <Image
        src={source}
        alt={alt}
        widths={widths}
        format="png"
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </picture>
    <span class="capture-hint" aria-hidden="true">
      {pl ? "Powiększ" : "Enlarge"}
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
      </svg>
    </span>
  </a>
</div>
