---
import type { Language } from "../data/projects";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const pl = lang === "pl";
const steps = pl
  ? [
      {
        label: "Ta sama wersja",
        title: "Oba urządzenia mają tę samą wersję danych.",
        states: ["Pobrano r7", "Wersja r7", "Pobrano r7"],
        notes: [
          "Historia na urządzeniu",
          "Zaszyfrowana kopia danych",
          "Historia na urządzeniu",
        ],
        caption:
          "Każde urządzenie pobiera kopię danych i odszyfrowuje ją lokalnie. Przy zapisie podaje numer pobranej wersji, żeby serwer mógł sprawdzić, czy dane są nadal aktualne.",
      },
      {
        label: "Niezależne zmiany",
        title: "Urządzenie A zapisuje zmiany, B nadal ma starszą wersję.",
        states: ["Zapisano r8", "Wersja r8", "Nadal r7"],
        notes: [
          "Dodanie do ulubionych → szyfrowanie → zapis",
          "Nowa zaszyfrowana kopia danych",
          "Lokalne zmiany czekają na synchronizację",
        ],
        caption:
          "Urządzenie A wysyła zmiany, podając wersję r7. Serwer przyjmuje zapis i nadaje danym wersję r8. Urządzenie B nadal pracuje na r7 i wprowadza własne zmiany.",
      },
      {
        label: "Konflikt",
        title: "Serwer odrzuca zapis oparty na starszej wersji.",
        states: ["Zapisano r8", "Wersja r8", "Zapis odrzucony"],
        notes: [
          "Zmiany już zsynchronizowane",
          "r7 jest już nieaktualna",
          "Próba zapisu na podstawie r7",
        ],
        caption:
          "Urządzenie B wysyła zaszyfrowane dane, podając wersję r7. Serwer ma już r8, więc odrzuca zapis. Zmiany urządzenia A pozostają zachowane.",
      },
      {
        label: "Scalenie i zapis",
        title: "Urządzenie B łączy obie wersje i ponawia zapis.",
        states: ["Może pobrać r9", "Wersja r9", "Zapisano r9"],
        notes: [
          "Pobranie → lokalne odszyfrowanie",
          "Połączone i zaszyfrowane dane",
          "Pobranie → scalenie → szyfrowanie",
        ],
        caption:
          "Urządzenie B pobiera r8 i łączy ją ze swoimi zmianami. Szyfruje wynik i ponawia zapis, podając wersję r8. Po trzech nieudanych próbach aplikacja zgłasza konflikt i zachowuje lokalne dane.",
      },
    ]
  : [
      {
        label: "Start together",
        title: "Both devices have the same revision.",
        states: ["Read r7", "Revision r7", "Read r7"],
        notes: [
          "History stays on the device",
          "Encrypted snapshot",
          "History stays on the device",
        ],
        caption:
          "Each device fetches the snapshot and decrypts it locally. When saving, each device sends that revision so the server can check whether its data is still current.",
      },
      {
        label: "Make changes",
        title: "One device saves. The other keeps working.",
        states: ["Saved r8", "Revision r8", "Still on r7"],
        notes: [
          "New favorite → encrypt → write",
          "New encrypted snapshot",
          "Independent local changes",
        ],
        caption:
          "Device A writes against r7. The server accepts the write and advances the revision. Device B is still working from the previous version.",
      },
      {
        label: "Reject stale write",
        title: "A stale write cannot replace newer data.",
        states: ["Saved r8", "Revision r8", "Write rejected"],
        notes: [
          "Changes already synchronized",
          "r7 is no longer current",
          "Attempts a write against r7",
        ],
        caption:
          "Device B submits an encrypted snapshot against r7. The revision check detects the conflict and protects Device A’s write.",
      },
      {
        label: "Merge and retry",
        title: "Device B merges the changes and retries.",
        states: ["Can fetch r9", "Revision r9", "Saved r9"],
        notes: [
          "Fetch → decrypt locally",
          "Merged, encrypted snapshot",
          "Fetch → merge → encrypt",
        ],
        caption:
          "B fetches r8, merges locally, encrypts, and writes against r8. Retries stop after three unsuccessful writes; local data is kept.",
      },
    ];
const names = pl
  ? ["Urządzenie A", "Serwer synchronizacji", "Urządzenie B"]
  : ["Device A", "Sync server", "Device B"];
---

<figure class="engineering-explanation sync-explanation">
  <fieldset class="explanation-controls">
    <legend>
      {pl
        ? "Jak aplikacja rozwiązuje konflikt synchronizacji"
        : "Follow a sync conflict"}
    </legend>
    {steps.map((step, index) => (
      <label>
        <input
          type="radio"
          name="sync-step"
          value={index}
          checked={index === 0}
          aria-controls={"sync-panel-" + index}
        />
        <span>
          <span class="step-number">{index + 1}</span>
          {step.label}
        </span>
      </label>
    ))}
  </fieldset>
  <div class="explanation-panels">
    {steps.map((step, index) => (
      <div class="explanation-panel" id={"sync-panel-" + index}>
        <h3>{step.title}</h3>
        <dl class="sync-lanes">
          {names.map((name, lane) => (
            <div>
              <dt>{name}</dt>
              <dd class="sync-revision">{step.states[lane]}</dd>
              <dd>{step.notes[lane]}</dd>
            </div>
          ))}
        </dl>
        <p class="explanation-caption">{step.caption}</p>
      </div>
    ))}
  </div>
  <figcaption>
    {pl
      ? "r7, r8 i r9 to przykładowe numery wersji danych. Serwer nie odszyfrowuje historii."
      : "r7, r8 and r9 are example revision numbers. The server never decrypts the history."}
  </figcaption>
</figure>
