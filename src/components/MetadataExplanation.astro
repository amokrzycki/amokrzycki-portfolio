---
import Arrow from "./Arrow.astro";
import type { Language } from "../data/projects";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const pl = lang === "pl";
const steps = pl
  ? [
      {
        label: "Rozbieżność",
        title: "Tytuł jest już nowy, ale czas dotyczy poprzedniego utworu.",
        states: [
          "REST: utwór B",
          "HLS: utwór A + czas",
          "Tytuł B bez czasu HLS",
        ],
        caption:
          "API REST i strumień HLS mogą zaktualizować informacje o utworze w różnym momencie. Jeśli tytuły się różnią, Kajtek pomija czas z HLS.",
      },
      {
        label: "Porównanie",
        title: "Aplikacja porównuje tytuły z obu źródeł.",
        states: [
          "Tytuły z REST i HLS",
          "Normalizacja i porównanie",
          "Dołączenie lub pominięcie czasu",
        ],
        caption:
          "Przy porównaniu aplikacja pomija wielkość liter i znaki przestankowe. Jeśli tytuły mają wspólny fragment, łączy dane. Takie dopasowanie daje mniejszą pewność niż identyfikator utworu od nadawcy.",
      },
      {
        label: "Zgodne dane",
        title: "Tytuł z API i czas ze strumienia trafiają do jednego modelu.",
        states: [
          "REST: tytuł i wykonawca",
          "HLS: początek i długość",
          "Utwór z danymi o czasie",
        ],
        caption:
          "Dane o czasie pochodzą z aktualnie odtwarzanego segmentu HLS. Aplikacja oblicza początek bloku na podstawie czasu segmentu. Dzięki temu kolejne odczyty nie zmieniają wyliczonej godziny rozpoczęcia utworu.",
      },
      {
        label: "Nieaktualny tag",
        title: "Nieaktualne dane o czasie wygasają po 30 sekundach.",
        states: ["Brak nowego tagu", "Wygaśnięcie po 30 s", "Dane z REST"],
        caption:
          "Po wstrzymaniu odtwarzania lub zatrzymaniu strumienia nowe tagi mogą przestać docierać. Po trzydziestu sekundach aplikacja odrzuca metadane HLS i korzysta z REST. Informacje o czasie są opcjonalne.",
      },
    ]
  : [
      {
        label: "Sources disagree",
        title: "A new title with the previous song’s timing.",
        states: [
          "REST: song B",
          "HLS: song A + timing",
          "Title B without HLS timing",
        ],
        caption:
          "REST and the stream do not always change tracks together. When their titles disagree, the integration leaves out the HLS timing.",
      },
      {
        label: "Compare titles",
        title: "Check that the titles describe the same song.",
        states: [
          "REST + HLS titles",
          "Normalize and compare",
          "Match or omit timing",
        ],
        caption:
          "The comparison ignores case and punctuation. A shared title substring allows the data to be combined, with less certainty than a provider-issued track ID.",
      },
      {
        label: "Combine data",
        title: "Combine the API title with stream timing.",
        states: [
          "REST: artist and title",
          "HLS: start and duration",
          "One track with timing",
        ],
        caption:
          "Timing comes from the segment playback has just entered. Deriving the block start from the segment timestamp keeps the calculated start time consistent across repeated reads.",
      },
      {
        label: "Expire stale tags",
        title: "HLS timing expires after 30 seconds.",
        states: ["No fresh tag", "Expire after 30 s", "REST data"],
        caption:
          "Pausing or stalling can stop new tags arriving. After thirty seconds, the integration discards HLS metadata; timing remains optional.",
      },
    ];
---

<figure class="engineering-explanation metadata-explanation">
  <fieldset class="explanation-controls">
    <legend>
      {pl
        ? "Jak Kajtek łączy dane o utworach ESKI"
        : "How Kajtek reconciles ESKA metadata"}
    </legend>
    {steps.map((step, index) => (
      <label>
        <input
          type="radio"
          name="metadata-step"
          value={index}
          checked={index === 0}
          aria-controls={"metadata-panel-" + index}
        />
        <span>
          <span class="step-number">{index + 1}</span>
          {step.label}
        </span>
      </label>
    ))}
  </fieldset>
  <div class="explanation-panels">
    {steps.map((step, index) => (
      <div class="explanation-panel" id={"metadata-panel-" + index}>
        <h3>{step.title}</h3>
        <ol class="metadata-flow">
          {step.states.map((state, lane) => (
            <li>
              <span>{state}</span>
              {lane < 2 && <Arrow />}
            </li>
          ))}
        </ol>
        <p class="explanation-caption">{step.caption}</p>
      </div>
    ))}
  </div>
  <figcaption>
    {pl
      ? "W integracji ESKI tytuł pochodzi z REST, a czas ze strumienia HLS. Kajtek łączy je w jednym modelu utworu."
      : "ESKA example: REST names and stream timing feed one track model."}
  </figcaption>
</figure>
