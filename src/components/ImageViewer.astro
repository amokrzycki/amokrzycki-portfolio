---
interface Props {
  lang: "en" | "pl";
}
const { lang } = Astro.props;
const pl = lang === "pl";
---

<dialog
  class="image-viewer"
  aria-labelledby="viewer-title"
  data-error={
    pl
      ? "Nie udało się wczytać obrazu. Zamknij podgląd i spróbuj ponownie."
      : "Couldn’t load the image. Close the viewer and try again."
  }
>
  <div class="viewer-toolbar">
    <p id="viewer-title">{pl ? "Podgląd aplikacji" : "App preview"}</p>
    <button class="viewer-zoom" type="button" hidden>
      {pl ? "Dopasuj do ekranu" : "Fit to screen"}
    </button>
    <form method="dialog">
      <button autofocus>
        {pl ? "Zamknij" : "Close"}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </form>
  </div>
  <div
    class="viewer-stage"
    tabindex="0"
    role="region"
    aria-label={
      pl
        ? "Podgląd obrazu. Kliknij obraz lub użyj Ctrl i przewijania, żeby powiększyć."
        : "Image viewer. Click the image or use Ctrl and scroll to zoom."
    }
  >
    <img
      alt=""
      tabindex="0"
      role="button"
      aria-pressed="false"
      aria-label={pl ? "Powiększ obraz" : "Zoom in"}
      data-zoom={pl ? "Powiększ obraz" : "Zoom in"}
      data-fit={pl ? "Dopasuj do ekranu" : "Fit to screen"}
    />
  </div>
  <p class="viewer-caption"></p>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>(".image-viewer")!;
  const image = viewer.querySelector<HTMLImageElement>("img")!;
  const caption = viewer.querySelector<HTMLElement>(".viewer-caption")!;
  const stage = viewer.querySelector<HTMLElement>(".viewer-stage")!;
  const zoom = viewer.querySelector<HTMLButtonElement>(".viewer-zoom")!;
  let trigger: HTMLAnchorElement | null = null;
  let scale = 1;

  function setZoom(nextScale: number, clientX?: number, clientY?: number) {
    if (!image.complete || !image.naturalWidth) return;
    const before = image.getBoundingClientRect();
    const x = clientX ?? before.left + before.width / 2;
    const y = clientY ?? before.top + before.height / 2;
    const focusX = (x - before.left) / before.width;
    const focusY = (y - before.top) / before.height;
    scale = Math.min(8, Math.max(1, nextScale));
    const enlarged = scale > 1;
    viewer.classList.toggle("is-zoomed", enlarged);
    zoom.hidden = !enlarged;
    image.setAttribute("aria-pressed", String(enlarged));
    image.setAttribute(
      "aria-label",
      enlarged ? image.dataset.fit! : image.dataset.zoom!,
    );
    if (!enlarged) {
      image.style.removeProperty("width");
      image.style.removeProperty("height");
      stage.scrollTo(0, 0);
      return;
    }
    const style = getComputedStyle(stage);
    const fit = Math.min(
      1,
      (stage.clientWidth -
        parseFloat(style.paddingLeft) -
        parseFloat(style.paddingRight)) /
        image.naturalWidth,
      (stage.clientHeight -
        parseFloat(style.paddingTop) -
        parseFloat(style.paddingBottom)) /
        image.naturalHeight,
    );
    image.style.width = `${image.naturalWidth * fit * scale}px`;
    image.style.height = `${image.naturalHeight * fit * scale}px`;
    const after = image.getBoundingClientRect();
    stage.scrollTo(
      stage.scrollLeft + after.left + focusX * after.width - x,
      stage.scrollTop + after.top + focusY * after.height - y,
    );
  }

  document
    .querySelectorAll<HTMLAnchorElement>("[data-image-viewer]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        trigger = link;
        scale = 1;
        zoom.hidden = true;
        image.style.removeProperty("width");
        image.style.removeProperty("height");
        image.src = link.href;
        image.alt = link.querySelector("img")?.alt ?? "";
        caption.textContent = image.alt;
        viewer.classList.remove("is-zoomed");
        image.setAttribute("aria-pressed", "false");
        image.setAttribute("aria-label", image.dataset.zoom!);
        viewer.showModal();
        document.documentElement.classList.add("viewer-open");
        stage.scrollTo(0, 0);
      });
    });
  zoom.addEventListener("click", () => {
    setZoom(1);
    image.focus({ preventScroll: true });
  });
  image.addEventListener("click", (event) => {
    setZoom(scale > 1 ? 1 : 2, event.clientX, event.clientY);
  });
  image.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    setZoom(scale > 1 ? 1 : 2);
  });
  stage.addEventListener(
    "wheel",
    (event) => {
      if (!event.ctrlKey) return;
      event.preventDefault();
      const delta =
        event.deltaY *
        (event.deltaMode === 1
          ? 16
          : event.deltaMode === 2
            ? stage.clientHeight
            : 1);
      setZoom(scale * Math.exp(-delta * 0.002), event.clientX, event.clientY);
    },
    { passive: false },
  );
  image.addEventListener("error", () => {
    caption.textContent = viewer.dataset.error!;
  });
  viewer.addEventListener("click", (event) => {
    if (event.target !== viewer) return;
    const rect = viewer.getBoundingClientRect();
    if (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    )
      viewer.close();
  });
  viewer.addEventListener("close", () => {
    document.documentElement.classList.remove("viewer-open");
    trigger?.focus({ preventScroll: true });
    image.removeAttribute("src");
  });
</script>
